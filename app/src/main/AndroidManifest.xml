<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 方控（按键映射）独立应用所需的权限 ===== -->
    <!-- 查询已安装应用（选应用 / 按包名拉起，Android 11+ 包可见性） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 结束后台进程（「结束当前应用」动作） -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 修改系统设置（亮度 / 自动旋转） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 修改音频设置（音量调节，Android 12+ 必需，否则会静默失败） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 手电筒（Camera2 setTorchMode） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通知（Android 13+ 通知监听服务需要） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <!-- WiFi / 蓝牙开关 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 开机广播（开机后恢复按键映射监听） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 悬浮窗（部分动作的提示层） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 精确闹钟（自启动链式调度） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.CarAssistant">

        <!-- 方控映射：独立应用的唯一入口 -->
        <activity
            android:name=".ui.KeyMappingActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                车机桌面图标分类元数据（红旗车机 launcher 依赖这些字段建图标）。
                缺少时应用虽已安装，桌面却不显示入口图标。
            -->
            <meta-data
                android:name="Group"
                android:value="GROUP AUTOMAP" />
            <meta-data
                android:name="Domain"
                android:value="DOMAIN AUTOMAP" />
            <meta-data
                android:name="Ability"
                android:value="com.carassistant.App" />
            <meta-data
                android:name="MoreApp"
                android:value="true" />
        </activity>

        <!--
            按键映射无障碍服务
            - 全局拦截物理按键（任意界面下生效）与模拟系统手势（返回/最近任务/锁屏等）
            - 不读取窗口内容，仅作按键拦截和手势派发
            - 必须由用户在系统「无障碍」设置中手动开启
        -->
        <service
            android:name=".service.KeyMappingAccessibilityService"
            android:exported="true"
            android:label="@string/keymap_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 按键映射输入法：捕获手柄 / 方向盘模拟轴事件（无键盘界面） -->
        <service
            android:name=".service.KeyMappingInputMethod"
            android:exported="true"
            android:label="@string/keymap_ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            媒体会话监听服务：方控媒体键定向派发到指定音乐应用
            必须由用户在系统「通知访问权限」中手动开启
        -->
        <service
            android:name=".service.TargetMediaSessionService"
            android:exported="true"
            android:label="@string/media_session_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 自启动链式闹钟接收器（AlarmManager 显式广播目标，必须注册） -->
        <receiver
            android:name=".receiver.AppAutoStartReceiver"
            android:exported="false" />
    </application>
</manifest>
