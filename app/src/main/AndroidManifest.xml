<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <!-- 存储权限 (Android 8 兼容使用旧版权限) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 查询已安装应用 (Android 11+ 包可见性) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 网络权限 (可选，预留) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 重启应用包权限 (用于结束后台进程) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 获取包使用情况 (用于扫描缓存大小) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 接收开机广播(可选，用于开机后启动悬浮按钮) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 安装 APK (Android 8+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 卸载 APK (Android 8+) - 避免 UninstallerActivity 因缺少权限被立即关闭 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- WiFi 状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 蓝牙（Android 11 及以下） -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- 蓝牙（Android 12+） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 修改系统设置（亮度调节、旋转锁定） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 相机（侧边栏手电筒开关，Android 6+ 通过 Camera2 setTorchMode） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.CarAssistant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.ControlPanelActivity"
            android:exported="false"
            android:label="@string/home_feature_control"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.DeviceInfoActivity"
            android:exported="false"
            android:label="@string/device_title"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.AutostartActivity"
            android:exported="false"
            android:label="@string/autostart_title"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.MonitorActivity"
            android:exported="false"
            android:label="@string/monitor_title"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.KeyMappingActivity"
            android:exported="false"
            android:label="@string/keymap_title"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.PermissionActivity"
            android:exported="false"
            android:label="@string/permission_guide_title"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".ui.MusicActivity"
            android:exported="false"
            android:label="@string/home_feature_music"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!--
            悬浮按钮服务
            - foregroundServiceType="specialUse"：Android 14+ 必需，否则 startForeground(type) 会抛 IllegalArgumentException
            - Android 9 会忽略未知属性，不影响兼容性
            - 子类型通过 meta-data PROPERTY_SPECIAL_USE_FGS_SUBTYPE 声明
        -->
        <service
            android:name=".service.FloatingButtonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <meta-data android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_button_quick_launcher" />
        </service>

        <!--
            侧边栏服务（替代悬浮球）
            - 屏幕左右边缘滑入触发，显示垂直侧边栏面板
            - 包含系统快捷开关、快捷应用网格、导航按钮
            - 前台服务保活，Android 14+ 使用 specialUse 类型
        -->
        <service
            android:name=".service.SidebarService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <meta-data android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="sidebar_quick_launcher" />
        </service>

        <!--
            按键映射无障碍服务
            - 用于全局拦截物理按键（任意界面下生效）
            - 用于系统手势模拟（返回、最近任务、锁屏等）
            - 不读取窗口内容，仅作按键拦截和手势派发
            - 必须由用户在系统设置中手动开启
        -->
        <service
            android:name=".service.KeyMappingAccessibilityService"
            android:exported="true"
            android:label="@string/keymap_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 性能监控悬浮窗服务 -->
        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <meta-data android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="performance_monitor_overlay" />
        </service>

        <!--
            媒体会话监听服务（NotificationListenerService）
            - 用于音乐伴侣获取活跃媒体会话（歌曲信息/封面/播放状态）
            - 用于方控媒体键定向派发到指定音乐应用
            - 必须由用户在系统「通知访问权限」中手动开启
            - BIND_NOTIFICATION_LISTENER_SERVICE 权限 + intent-filter 缺一不可，否则不出现在授权列表
        -->
        <service
            android:name=".service.TargetMediaSessionService"
            android:exported="true"
            android:label="@string/media_session_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 开机自启 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- U 盘插拔监听 -->
        <receiver
            android:name=".receiver.UsbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_REMOVED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- 文件分享 (Android 7+ 安装 APK 必需) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <meta-data
            android:name="Group"
            android:value="GROUP AUTOMAP" />
        <meta-data
            android:name="Domain"
            android:value="DOMAIN AUTOMAP" />
        <meta-data
            android:name="Ability"
            android:value="红旗车机助手" />
        <meta-data
            android:name="MoreApp"
            android:value="true" />
    </application>
</manifest>
