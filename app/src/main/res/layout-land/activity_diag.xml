<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/cv_bg"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="20dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.36">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/cv_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diag_title"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cv_accent"
                android:id="@+id/backBtn"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="返回"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cv_muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="开关门/挂档/拨转向后再点，看数字变不变"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/cv_text"
            android:id="@+id/doorDiagBtn"
            android:background="@drawable/cv_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="门状态诊断"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/cv_text"
            android:id="@+id/gearDiagBtn"
            android:background="@drawable/cv_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="档位当前值"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/cv_text"
            android:id="@+id/turnDiagBtn"
            android:background="@drawable/cv_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="转向灯/双闪诊断"/>
    </LinearLayout>
    <View
        android:background="@color/cv_line"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <ScrollView
        android:paddingLeft="24dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_weight="0.64">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/cv_text"
            android:id="@+id/diagResult"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="结果会显示在这里"
            android:lineSpacingExtra="5dp"
            android:textIsSelectable="true"/>
    </ScrollView>
</LinearLayout>
