<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/cv_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.32">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/cv_brand"
            android:id="@+id/brandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cv_accent"
                android:id="@+id/aboutBtn"
                android:background="@drawable/cv_about_chip"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cv_about_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cv_muted"
                android:id="@+id/diagBtn"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/diag_title"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/cv_master_row"
            android:paddingLeft="12dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_master_label"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/cv_accent"
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off"/>
            </LinearLayout>
            <CheckBox
                android:id="@+id/enableCB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.25"
                android:scaleY="1.25"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/cv_master_row"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/cv_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vol_boost_label"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/cv_muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/vol_boost_hint"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/volBoostCB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="1.15"
                    android:scaleY="1.15"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/volLevelRow"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cv_muted"
                    android:gravity="center"
                    android:id="@+id/volMid"
                    android:background="@drawable/cv_tab_off"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/vol_level_mid"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text"
                    android:gravity="center"
                    android:id="@+id/volMidHigh"
                    android:background="@drawable/cv_tab_on"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:text="@string/vol_level_mid_high"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cv_muted"
                    android:gravity="center"
                    android:id="@+id/volMax"
                    android:background="@drawable/cv_tab_off"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:text="@string/vol_level_max"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/a11yBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:textSize="13sp"
                android:textColor="@color/cv_accent"
                android:id="@+id/openA11yBtn"
                android:background="@drawable/cv_btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="打开无障碍设置"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/cv_muted"
                android:id="@+id/a11yHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hint_a11y"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cv_text"
            android:gravity="center"
            android:id="@+id/tabGear"
            android:background="@drawable/cv_tab_on"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:text="档位音频"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cv_muted"
            android:gravity="center"
            android:id="@+id/tabDoor"
            android:background="@drawable/cv_tab_off"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="车门音频"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cv_muted"
            android:gravity="center"
            android:id="@+id/tabMore"
            android:background="@drawable/cv_tab_off"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="转向灯"/>
    </LinearLayout>
    <View
        android:background="@color/cv_line"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:paddingLeft="18dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.68">
        <ScrollView
            android:id="@+id/pageGear"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/cv_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="启用档位播报"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/gearCB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/gearEventHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/pageDoor"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckBox
                        android:textColor="@color/cv_text"
                        android:id="@+id/doorFlCB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="主驾"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:textColor="@color/cv_text"
                        android:id="@+id/doorFrCB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="副驾"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:textColor="@color/cv_text"
                        android:id="@+id/doorRlCB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="左后"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:textColor="@color/cv_text"
                        android:id="@+id/doorRrCB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="右后"
                        android:layout_weight="1"/>
                </LinearLayout>
                <CheckBox
                    android:textColor="@color/cv_text"
                    android:id="@+id/doorOpenOnlyCB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="仅播「打开」"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/doorEventHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/pageMore"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/cv_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="启用转向灯/双闪播报"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/turnCB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cv_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/turn_hint"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/turnEventHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="@color/cv_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"/>
                <CheckBox
                    android:textColor="@color/cv_text"
                    android:id="@+id/bootCB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开机提醒开启无障碍"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
