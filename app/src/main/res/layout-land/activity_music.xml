<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣主界面 - 横屏布局（网易云音乐风格）
    - 纯黑渐变背景
    - 左右排列：左侧黑胶唱片（含唱臂导轨），右侧歌词区
    - 底部控制栏
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_page"
    android:orientation="vertical">

    <!-- 顶部头部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_home_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:tint="@color/music_text_primary"
            tools:ignore="UseAppTint"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/music_title"
            android:textColor="@color/music_text_primary"
            android:textSize="18sp"/>

        <ImageView
            android:id="@+id/btn_floating_lyrics"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_music_lyrics_hongqi"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="@string/floating_lyrics_toggle"
            android:tint="@color/music_text_hint"
            tools:ignore="UseAppTint"/>

        <ImageView
            android:id="@+id/btn_lyrics_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="@string/floating_lyrics_settings"
            android:tint="@color/music_text_hint"
            tools:ignore="UseAppTint"/>
    </LinearLayout>

    <!-- 权限引导卡片 -->
    <LinearLayout
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_music_permission_card"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:padding="32dp"
        android:visibility="gone"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_permission_required"
            android:textColor="@color/music_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/keymap_perm_media_session_tip"
            android:textColor="@color/music_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:id="@+id/btn_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_play_button_hongqi"
            android:text="@string/keymap_perm_go_grant"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 主内容区：左右排列（黑胶唱片 | 歌词） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- 左侧：黑胶唱片（含唱臂导轨） -->
        <FrameLayout
            android:id="@+id/card_album"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center">

            <View
                android:id="@+id/vinyl_glow"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <!-- 内部 wrap_content 容器：让唱臂 top|end 相对唱片定位，而非整个 weight 区域 -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/iv_vinyl"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bg_vinyl_disc"
                    tools:ignore="ContentDescription"/>

                <ImageView
                    android:id="@+id/iv_album"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_music_cover_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_album_circle"
                    tools:ignore="ContentDescription"/>

                <!-- 唱臂（从右上枢轴延伸到唱片中心，真实唱机样式） -->
                <ImageView
                    android:id="@+id/iv_tonearm"
                    android:layout_width="155dp"
                    android:layout_height="155dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-28dp"
                    android:layout_marginEnd="-35dp"
                    android:src="@drawable/bg_tonearm"
                    android:scaleType="fitXY"
                    tools:ignore="ContentDescription"/>
            </FrameLayout>
        </FrameLayout>

        <!-- 右侧：歌曲信息 + 歌词 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="8dp">

            <!-- 歌曲信息区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/music_no_song"
                    android:textColor="@color/music_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/music_unknown_artist"
                        android:textColor="@color/music_text_hint"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 歌词区（5 行歌词 + 翻译，横屏占据更大空间） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <!-- 上上行（最远，最淡最小） -->
                <TextView
                    android:id="@+id/tv_lyric_prev2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:alpha="0.35"
                    android:textColor="@color/music_lyric_other"
                    android:textSize="14sp"/>

                <!-- 上一行（较淡较小） -->
                <TextView
                    android:id="@+id/tv_lyric_prev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="5dp"
                    android:alpha="0.6"
                    android:textColor="@color/music_lyric_other"
                    android:textSize="17sp"/>

                <!-- 当前行（高亮加粗） -->
                <TextView
                    android:id="@+id/tv_lyric_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="2dp"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/music_no_lyrics"
                    android:textColor="@color/music_lyric_current"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <!-- 翻译歌词（双语显示，紧跟当前行） -->
                <TextView
                    android:id="@+id/tv_lyric_translation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="5dp"
                    android:alpha="0.8"
                    android:textColor="@color/music_text_hint"
                    android:textSize="15sp"
                    android:visibility="gone"/>

                <!-- 下一行（较淡较小） -->
                <TextView
                    android:id="@+id/tv_lyric_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:alpha="0.6"
                    android:textColor="@color/music_lyric_other"
                    android:textSize="17sp"/>

                <!-- 下下行（最远，最淡最小） -->
                <TextView
                    android:id="@+id/tv_lyric_next2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="5dp"
                    android:alpha="0.35"
                    android:textColor="@color/music_lyric_other"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="16dp"
        android:paddingTop="4dp">

        <View
            android:id="@+id/play_btn_glow"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
        <View
            android:id="@+id/ambient_glow_1"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
        <View
            android:id="@+id/ambient_glow_2"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>

        <!-- 进度条区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/sb_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/music_seekbar_progress"
                android:progressBackgroundTint="@color/music_seekbar_track"
                android:thumbTint="@color/music_seekbar_thumb"
                android:splitTrack="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_hint"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_hint"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 控制按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/btn_repeat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_music_repeat_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_repeat_all"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_music_prev_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_prev"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"/>

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_play_button_hongqi"/>
                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_music_play_hongqi"
                    android:scaleType="center"
                    android:padding="18dp"
                    android:contentDescription="@string/music_play"
                    tools:ignore="UseAppTint"/>
            </FrameLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"/>

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_music_next_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_next"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 音乐来源图标 -->
            <ImageView
                android:id="@+id/btn_music_source"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_music_cover_placeholder"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                android:contentDescription="@string/music_source"
                android:visibility="gone"
                tools:ignore="UseAppTint"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
