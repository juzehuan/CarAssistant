<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣主界面（网易云音乐风格）
    - 纯黑渐变背景，无多余装饰
    - 大尺寸黑胶唱片（320dp）居中
    - 歌曲信息 + 三行歌词
    - 简约控制条：白色图标 + 红色播放按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_page"
    android:orientation="vertical">

    <!-- 顶部头部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_home_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:tint="@color/music_text_primary"
            tools:ignore="UseAppTint"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/music_title"
            android:textColor="@color/music_text_primary"
            android:textSize="18sp"/>

        <!-- 桌面歌词开关（网易云红色图标，激活时高亮） -->
        <ImageView
            android:id="@+id/btn_floating_lyrics"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_music_lyrics_hongqi"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="@string/floating_lyrics_toggle"
            android:tint="@color/music_text_hint"
            tools:ignore="UseAppTint"/>

        <!-- 桌面歌词设置（齿轮图标） -->
        <ImageView
            android:id="@+id/btn_lyrics_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="@string/floating_lyrics_settings"
            android:tint="@color/music_text_hint"
            tools:ignore="UseAppTint"/>
    </LinearLayout>

    <!-- 权限引导卡片（网易云风格，未授权通知访问权限时显示） -->
    <LinearLayout
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_music_permission_card"
        android:layout_marginStart="@dimen/music_content_padding"
        android:layout_marginEnd="@dimen/music_content_padding"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:padding="28dp"
        android:visibility="gone"
        android:gravity="center">

        <!-- 顶部图标圆形背景（品牌色渐变） -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_permission_icon_circle"/>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                app:tint="#FFFFFFFF"
                android:scaleType="centerInside"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <!-- 主标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_permission_required"
            android:textColor="@color/music_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- 副标题（说明用途） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/music_permission_subtitle"
            android:textColor="@color/music_text_hint"
            android:textSize="13sp"
            android:gravity="center"/>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#22FFFFFF"/>

        <!-- 步骤说明（带圆形数字标记） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_permission_step_circle"
                android:text="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/music_permission_step1"
                android:textColor="@color/music_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_permission_step_circle"
                android:text="2"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/music_permission_step2"
                android:textColor="@color/music_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <!-- 授权按钮（品牌色渐变 CTA） -->
        <TextView
            android:id="@+id/btn_grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_permission_grant_btn"
            android:text="@string/keymap_perm_go_grant"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"/>
    </LinearLayout>

    <!-- 主内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/music_content_padding"
        android:paddingEnd="@dimen/music_content_padding">

        <!-- 黑胶唱片专辑封面区（含唱臂导轨） -->
        <FrameLayout
            android:id="@+id/card_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground">

            <!-- 隐藏的光晕视图（保留 ID 兼容代码，网易云风格不显示） -->
            <View
                android:id="@+id/vinyl_glow"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <!-- 黑胶唱片背景（含旋转动画） -->
            <ImageView
                android:id="@+id/iv_vinyl"
                android:layout_width="@dimen/music_vinyl_size"
                android:layout_height="@dimen/music_vinyl_size"
                android:layout_gravity="center"
                android:src="@drawable/bg_vinyl_disc"
                tools:ignore="ContentDescription"/>

            <!-- 专辑封面（圆形，220dp，覆盖唱片中心，网易云经典样式） -->
            <ImageView
                android:id="@+id/iv_album"
                android:layout_width="@dimen/music_album_size"
                android:layout_height="@dimen/music_album_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_cover_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_album_circle"
                tools:ignore="ContentDescription"/>

            <!-- 唱臂（从右上枢轴延伸到唱片中心，真实唱机样式） -->
            <ImageView
                android:id="@+id/iv_tonearm"
                android:layout_width="@dimen/music_tonearm_size"
                android:layout_height="@dimen/music_tonearm_size"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/music_tonearm_margin_top"
                android:layout_marginEnd="@dimen/music_tonearm_margin_end"
                android:src="@drawable/bg_tonearm"
                android:scaleType="fitXY"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <!-- 歌曲信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="@dimen/music_title_margin_top">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_no_song"
                android:textColor="@color/music_text_primary"
                android:textSize="@dimen/music_title_size"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/music_unknown_artist"
                    android:textColor="@color/music_text_hint"
                    android:textSize="@dimen/music_artist_size"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 歌词区（5 行歌词 + 翻译，网易云风格滚动歌词） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <!-- 上上行（最远，最淡最小） -->
            <TextView
                android:id="@+id/tv_lyric_prev2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.35"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>

            <!-- 上一行（较淡较小） -->
            <TextView
                android:id="@+id/tv_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:alpha="0.6"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <!-- 当前行（高亮加粗） -->
            <TextView
                android:id="@+id/tv_lyric_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:lineSpacingExtra="6dp"
                android:text="@string/music_no_lyrics"
                android:textColor="@color/music_lyric_current"
                android:textSize="@dimen/music_lyric_current_size"
                android:textStyle="bold"/>

            <!-- 翻译歌词（双语显示，紧跟当前行） -->
            <TextView
                android:id="@+id/tv_lyric_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp"
                android:alpha="0.8"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_lyric_translation_size"
                android:visibility="gone"/>

            <!-- 下一行（较淡较小） -->
            <TextView
                android:id="@+id/tv_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.6"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <!-- 下下行（最远，最淡最小） -->
            <TextView
                android:id="@+id/tv_lyric_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:alpha="0.35"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 底部控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="@dimen/music_content_padding"
        android:paddingTop="8dp">

        <!-- 隐藏的光晕视图（保留 ID 兼容代码） -->
        <View
            android:id="@+id/play_btn_glow"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>

        <!-- 隐藏的背景光斑（保留 ID 兼容代码） -->
        <View
            android:id="@+id/ambient_glow_1"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
        <View
            android:id="@+id/ambient_glow_2"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>

        <!-- 进度条区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/sb_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/music_seekbar_progress"
                android:progressBackgroundTint="@color/music_seekbar_track"
                android:thumbTint="@color/music_seekbar_thumb"
                android:splitTrack="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_hint"
                    android:textSize="@dimen/music_time_text_size"
                    android:fontFamily="monospace"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_hint"
                    android:textSize="@dimen/music_time_text_size"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 控制按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <!-- 循环模式 -->
            <ImageView
                android:id="@+id/btn_repeat"
                android:layout_width="@dimen/music_repeat_btn_size"
                android:layout_height="@dimen/music_repeat_btn_size"
                android:src="@drawable/ic_music_repeat_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_repeat_all"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 上一首 -->
            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="@dimen/music_prev_next_btn_size"
                android:layout_height="@dimen/music_prev_next_btn_size"
                android:src="@drawable/ic_music_prev_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_prev"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"/>

            <!-- 播放/暂停（红色圆形主按钮） -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_play_button_hongqi"/>
                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_music_play_hongqi"
                    android:scaleType="center"
                    android:padding="18dp"
                    android:contentDescription="@string/music_play"
                    tools:ignore="UseAppTint"/>
            </FrameLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"/>

            <!-- 下一首 -->
            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="@dimen/music_prev_next_btn_size"
                android:layout_height="@dimen/music_prev_next_btn_size"
                android:src="@drawable/ic_music_next_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_next"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 音乐来源图标（显示对应音乐app图标，点击跳转） -->
            <ImageView
                android:id="@+id/btn_music_source"
                android:layout_width="@dimen/music_source_btn_size"
                android:layout_height="@dimen/music_source_btn_size"
                android:src="@drawable/ic_music_cover_placeholder"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                android:contentDescription="@string/music_source"
                android:visibility="gone"
                tools:ignore="UseAppTint"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
