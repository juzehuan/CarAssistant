<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣主界面（鸿启桌面风格）
    - 深色暖色调背景，营造黑胶唱片夜间氛围
    - 顶部：返回 + 标题
    - 主体：黑胶唱片专辑封面（可旋转） + 歌曲信息 + 歌词
    - 底部：进度条 + 控制按钮（固定底部，避免大屏幕下方空白）
    - 未授权通知访问权限时显示权限引导卡片
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_page"
    android:orientation="vertical">

    <!-- 顶部头部栏（固定高度） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:tint="@color/music_text_primary"
            tools:ignore="UseAppTint"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/music_title"
            android:textColor="@color/music_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>
    </LinearLayout>

    <!-- 权限引导卡片（未授权通知访问权限时显示） -->
    <LinearLayout
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_music_permission_card"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:padding="32dp"
        android:visibility="gone"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_permission_required"
            android:textColor="@color/music_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/keymap_perm_media_session_tip"
            android:textColor="@color/music_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:id="@+id/btn_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_play_button_hongqi"
            android:text="@string/keymap_perm_go_grant"
            android:textColor="#FF1A1410"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 主内容区（权重 1，撑满中间空间，内容垂直居中） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- 黑胶唱片专辑封面区 -->
        <FrameLayout
            android:id="@+id/card_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground">

            <!-- 黑胶唱片背景 -->
            <ImageView
                android:id="@+id/iv_vinyl"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_vinyl_disc"
                tools:ignore="ContentDescription"/>

            <!-- 专辑封面（圆形，叠在唱片中心） -->
            <ImageView
                android:id="@+id/iv_album"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_cover_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_album_circle"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <!-- 歌曲信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_no_song"
                android:textColor="@color/music_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/music_unknown_artist"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="14sp"/>

                <!-- 状态徽章 -->
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_status_disabled"
                    android:text="@string/music_disconnected"
                    android:textColor="@color/music_text_hint"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 歌词区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/tv_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/music_lyric_other"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_lyric_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/music_no_lyrics"
                android:textColor="@color/music_lyric_current"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/music_lyric_other"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 底部控制区（固定底部，包含进度条和控制按钮） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp"
        android:paddingTop="8dp">

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/music_divider"/>

        <!-- 进度条区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <SeekBar
                android:id="@+id/sb_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/music_seekbar_progress"
                android:progressBackgroundTint="@color/music_seekbar_track"
                android:thumbTint="@color/music_seekbar_thumb"
                android:splitTrack="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_hint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_hint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 控制按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <!-- 循环模式 -->
            <ImageView
                android:id="@+id/btn_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_music_repeat_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_repeat_all"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 上一首 -->
            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_music_prev_hongqi"
                android:background="@drawable/bg_music_icon_circle"
                android:scaleType="center"
                android:contentDescription="@string/music_prev"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="16dp"
                android:layout_height="1dp"/>

            <!-- 播放/暂停（金色圆形主按钮） -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_play_button_hongqi"/>
                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_music_play_hongqi"
                    android:scaleType="center"
                    android:padding="16dp"
                    android:contentDescription="@string/music_play"
                    tools:ignore="UseAppTint"/>
            </FrameLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="1dp"/>

            <!-- 下一首 -->
            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_music_next_hongqi"
                android:background="@drawable/bg_music_icon_circle"
                android:scaleType="center"
                android:contentDescription="@string/music_next"
                tools:ignore="UseAppTint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
