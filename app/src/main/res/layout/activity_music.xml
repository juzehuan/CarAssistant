<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣主界面（网易云音乐黑胶唱片播放页风格）
    - 全屏深色背景
    - 顶部：下拉返回箭头 + 居中歌名/歌手
    - 中部：大尺寸黑胶唱片 + 唱臂
    - 底部：功能区（喜欢/下载/循环/歌词）+ 进度条 + 播放控制
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_page"
    android:orientation="vertical">

    <!-- 顶部头部：下拉箭头 + 歌名/歌手居中 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_music_arrow_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/back"
            tools:ignore="ContentDescription"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_no_song"
                android:textColor="@color/music_text_primary"
                android:textSize="@dimen/music_title_size"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_unknown_artist"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_artist_size"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 权限引导卡片 -->
    <LinearLayout
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_music_permission_card"
        android:layout_marginStart="@dimen/music_content_padding"
        android:layout_marginEnd="@dimen/music_content_padding"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:padding="28dp"
        android:visibility="gone"
        android:gravity="center">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_permission_icon_circle"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                app:tint="#FFFFFFFF"
                android:scaleType="centerInside"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_permission_required"
            android:textColor="@color/music_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/music_permission_subtitle"
            android:textColor="@color/music_text_hint"
            android:textSize="13sp"
            android:gravity="center"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#22FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_permission_step_circle"
                android:text="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/music_permission_step1"
                android:textColor="@color/music_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_permission_step_circle"
                android:text="2"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/music_permission_step2"
                android:textColor="@color/music_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_permission_grant_btn"
            android:text="@string/keymap_perm_go_grant"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"/>
    </LinearLayout>

    <!-- 主内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/music_content_padding"
        android:paddingEnd="@dimen/music_content_padding">

        <!-- 黑胶唱片专辑封面区 -->
        <FrameLayout
            android:id="@+id/card_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/vinyl_glow"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/iv_vinyl"
                android:layout_width="@dimen/music_vinyl_size"
                android:layout_height="@dimen/music_vinyl_size"
                android:layout_gravity="center"
                android:src="@drawable/bg_vinyl_disc"
                tools:ignore="ContentDescription"/>

            <ImageView
                android:id="@+id/iv_album"
                android:layout_width="@dimen/music_album_size"
                android:layout_height="@dimen/music_album_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_cover_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_album_circle"
                tools:ignore="ContentDescription"/>

            <ImageView
                android:id="@+id/iv_tonearm"
                android:layout_width="@dimen/music_tonearm_size"
                android:layout_height="@dimen/music_tonearm_height"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/music_tonearm_margin_top"
                android:layout_marginEnd="@dimen/music_tonearm_margin_end"
                android:src="@drawable/bg_tonearm"
                android:scaleType="fitXY"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <!-- 歌词区（默认显示，点击“词”按钮收起） -->
        <LinearLayout
            android:id="@+id/lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_lyric_prev2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.35"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>

            <TextView
                android:id="@+id/tv_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:alpha="0.6"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:lineSpacingExtra="6dp"
                android:text="@string/music_no_lyrics"
                android:textColor="@color/music_lyric_current"
                android:textSize="@dimen/music_lyric_current_size"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_lyric_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp"
                android:alpha="0.8"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_lyric_translation_size"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.6"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:alpha="0.35"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 隐藏的旧按钮（保留 ID 兼容代码） -->
    <ImageView
        android:id="@+id/btn_floating_lyrics"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/btn_lyrics_settings"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    <!-- 底部操作按钮：统一一行（循环 / 歌词 / 上一首 / 播放 / 下一首 / 打开音乐App） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_music_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/music_settings"
            android:tint="@color/music_text_secondary"
            tools:ignore="UseAppTint"/>

        <ImageView
            android:id="@+id/btn_lyrics_toggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_music_lyrics_hongqi"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/floating_lyrics_toggle"
            android:tint="@color/music_text_primary"
            tools:ignore="UseAppTint"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="@dimen/music_prev_next_btn_size"
            android:layout_height="@dimen/music_prev_next_btn_size"
            android:src="@drawable/ic_music_prev_hongqi"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="@string/music_prev"
            android:tint="@color/music_text_primary"
            tools:ignore="UseAppTint"/>

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_music_play_ring"/>
            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_music_play_hongqi"
                android:scaleType="center"
                android:padding="18dp"
                android:contentDescription="@string/music_play"
                tools:ignore="UseAppTint"/>
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="@dimen/music_prev_next_btn_size"
            android:layout_height="@dimen/music_prev_next_btn_size"
            android:src="@drawable/ic_music_next_hongqi"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="@string/music_next"
            android:tint="@color/music_text_primary"
            tools:ignore="UseAppTint"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btn_playlist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_music_list"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            tools:ignore="ContentDescription"/>
    </LinearLayout>

    <View
        android:id="@+id/play_btn_glow"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <View
        android:id="@+id/ambient_glow_1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <View
        android:id="@+id/ambient_glow_2"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    <!-- 进度条区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="8dp">

        <SeekBar
            android:id="@+id/sb_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/music_seekbar_progress"
            android:progressBackgroundTint="@color/music_seekbar_track"
            android:thumbTint="@color/music_seekbar_thumb"
            android:splitTrack="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tv_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_time_text_size"
                android:fontFamily="monospace"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_time_text_size"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>



    <!-- 音乐来源按钮（保留 ID 兼容代码） -->
    <ImageView
        android:id="@+id/btn_music_source"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

</LinearLayout>