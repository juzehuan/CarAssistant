<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣主界面（竖屏，网易云音乐黑胶唱片播放页风格）
    - 多层深色渐变背景 + 顶部/底部暗角，营造沉浸感
    - 顶部：下拉返回箭头 + 居中歌名/歌手 + 设置按钮 + 渐变遮罩
    - 中部：大尺寸黑胶唱片（带呼吸光晕）+ 唱臂 + 五行动态歌词
    - 底部：律动频谱 + 进度条 + 播放控制栏（渐变遮罩背景）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_page"
    android:orientation="vertical">

    <!-- 顶部头部区域（含渐变遮罩） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <!-- 顶部渐变遮罩（增强沉浸感） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_music_top_overlay"/>

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_music_arrow_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/back"
            android:elevation="2dp"
            tools:ignore="ContentDescription"/>

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_music_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/music_settings"
            android:tint="@color/music_text_secondary"
            android:elevation="2dp"
            tools:ignore="UseAppTint"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:paddingBottom="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="1dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_no_song"
                android:textColor="@color/music_text_primary"
                android:textSize="@dimen/music_title_size"
                android:textStyle="bold"
                android:shadowColor="#44000000"
                android:shadowDy="1"
                android:shadowRadius="4"/>

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_unknown_artist"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_artist_size"
                android:alpha="0.85"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 头部分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_music_header_divider"/>

    <!-- 权限引导卡片 -->
    <LinearLayout
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_music_permission_card"
        android:layout_marginStart="@dimen/music_content_padding"
        android:layout_marginEnd="@dimen/music_content_padding"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:padding="28dp"
        android:visibility="gone"
        android:gravity="center"
        android:elevation="4dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_permission_icon_circle"/>
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                app:tint="#FFFFFFFF"
                android:scaleType="centerInside"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_permission_required"
            android:textColor="@color/music_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/music_permission_subtitle"
            android:textColor="@color/music_text_hint"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#18FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_permission_step_circle"
                android:text="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/music_permission_step1"
                android:textColor="@color/music_text_secondary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_permission_step_circle"
                android:text="2"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/music_permission_step2"
                android:textColor="@color/music_text_secondary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bg_permission_grant_btn"
            android:text="@string/keymap_perm_go_grant"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:elevation="2dp"/>
    </LinearLayout>

    <!-- 主内容区（纵向/横向可切换） -->
    <LinearLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/music_content_padding"
        android:paddingEnd="@dimen/music_content_padding">

        <!-- 黑胶唱片专辑封面区 -->
        <FrameLayout
            android:id="@+id/card_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:foreground="?attr/selectableItemBackground">

            <!-- 唱片呼吸光晕 -->
            <View
                android:id="@+id/vinyl_glow"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <!-- 黑胶碟片 -->
            <ImageView
                android:id="@+id/iv_vinyl"
                android:layout_width="@dimen/music_vinyl_size"
                android:layout_height="@dimen/music_vinyl_size"
                android:layout_gravity="center"
                android:src="@drawable/bg_vinyl_disc"
                android:elevation="1dp"
                tools:ignore="ContentDescription"/>

            <!-- 专辑封面 -->
            <ImageView
                android:id="@+id/iv_album"
                android:layout_width="@dimen/music_album_size"
                android:layout_height="@dimen/music_album_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_cover_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_album_circle"
                android:elevation="2dp"
                tools:ignore="ContentDescription"/>

            <!-- 唱臂 -->
            <ImageView
                android:id="@+id/iv_tonearm"
                android:layout_width="@dimen/music_tonearm_size"
                android:layout_height="@dimen/music_tonearm_height"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/music_tonearm_margin_top"
                android:layout_marginEnd="@dimen/music_tonearm_margin_end"
                android:src="@drawable/bg_tonearm"
                android:scaleType="fitXY"
                android:elevation="3dp"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <!-- 歌词区 -->
        <LinearLayout
            android:id="@+id/lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_lyric_prev2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.30"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>

            <TextView
                android:id="@+id/tv_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="8dp"
                android:alpha="0.55"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:lineSpacingExtra="8dp"
                android:text="@string/music_no_lyrics"
                android:textColor="@color/music_lyric_current"
                android:textSize="@dimen/music_lyric_current_size"
                android:textStyle="bold"
                android:shadowColor="#44FF2D55"
                android:shadowDy="1"
                android:shadowRadius="12"/>

            <TextView
                android:id="@+id/tv_lyric_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="8dp"
                android:alpha="0.80"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_lyric_translation_size"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.55"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="8dp"
                android:alpha="0.30"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 隐藏的旧按钮（保留 ID 兼容代码） -->
    <ImageView
        android:id="@+id/btn_floating_lyrics"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/btn_lyrics_settings"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    <!-- 音乐律动频谱条 -->
    <com.carassistant.ui.MusicVisualizerView
        android:id="@+id/music_visualizer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"/>

    <!-- 控制栏上方分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_music_control_divider"/>

    <!-- 进度条区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="10dp">

        <SeekBar
            android:id="@+id/sb_progress"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_music_seekbar_track"
            android:thumb="@drawable/bg_music_seekbar_thumb"
            android:splitTrack="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_time_text_size"
                android:fontFamily="monospace"
                android:alpha="0.85"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_time_text_size"
                android:fontFamily="monospace"
                android:alpha="0.85"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部播放控制栏（含渐变遮罩背景） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 底部渐变遮罩 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_music_bottom_overlay"/>

        <LinearLayout
            android:id="@+id/bottom_control_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:elevation="2dp">

            <!-- 歌词开关 -->
            <ImageView
                android:id="@+id/btn_lyrics_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_music_lyrics_hongqi"
                android:background="@drawable/bg_music_icon_circle"
                android:scaleType="centerInside"
                android:contentDescription="@string/floating_lyrics_toggle"
                android:tint="@color/music_text_primary"
                android:padding="8dp"
                tools:ignore="UseAppTint"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 上一首 -->
            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="@dimen/music_prev_next_btn_size"
                android:layout_height="@dimen/music_prev_next_btn_size"
                android:src="@drawable/ic_music_prev_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_prev"
                android:tint="@color/music_text_primary"
                android:alpha="0.90"
                tools:ignore="UseAppTint"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 播放/暂停按钮（带光环） -->
            <FrameLayout
                android:id="@+id/btn_play_container"
                android:layout_width="@dimen/music_prev_next_btn_size"
                android:layout_height="@dimen/music_prev_next_btn_size"
                android:elevation="4dp">
                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_music_play_ring"/>
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_music_play_ring_enhanced"
                    android:visibility="gone"/>
                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_music_play_hongqi"
                    android:scaleType="center"
                    android:padding="14dp"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="@string/music_play"
                    tools:ignore="UseAppTint"/>
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 下一首 -->
            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="@dimen/music_prev_next_btn_size"
                android:layout_height="@dimen/music_prev_next_btn_size"
                android:src="@drawable/ic_music_next_hongqi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/music_next"
                android:tint="@color/music_text_primary"
                android:alpha="0.90"
                tools:ignore="UseAppTint"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 播放列表 -->
            <ImageView
                android:id="@+id/btn_playlist"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_music_list"
                android:scaleType="centerInside"
                android:alpha="0.70"
                android:contentDescription="@string/music_playlist"
                tools:ignore="ContentDescription"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 特效占位 View（代码中动态定位） -->
    <View
        android:id="@+id/play_btn_glow"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <View
        android:id="@+id/ambient_glow_1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <View
        android:id="@+id/ambient_glow_2"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    <!-- 音乐来源按钮（保留 ID 兼容代码） -->
    <ImageView
        android:id="@+id/btn_music_source"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

</LinearLayout>
