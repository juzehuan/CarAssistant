<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣主界面（竖屏，网易云音乐黑胶唱片播放页风格）
    - 多层深色渐变背景 + 顶部/底部暗角，营造沉浸感
    - 顶部：下拉返回箭头 + 居中歌名/歌手 + 设置按钮 + 渐变遮罩
    - 中部：大尺寸黑胶唱片（带呼吸光晕）+ 唱臂 + 五行动态歌词
    - 底部：律动频谱 + 进度条 + 播放控制栏（渐变遮罩背景）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_page"
    android:orientation="vertical">

    <!-- 顶部头部区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_music_arrow_down"
            android:background="@drawable/bg_music_header_action"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/back"
            android:elevation="2dp"
            tools:ignore="ContentDescription"/>

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_music_settings"
            android:background="@drawable/bg_music_header_action"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/music_settings"
            android:tint="@color/music_text_secondary"
            android:elevation="2dp"
            tools:ignore="UseAppTint"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            android:paddingBottom="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="1dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_no_song"
                android:textColor="@color/music_text_primary"
                android:textSize="@dimen/music_title_size"
                android:textStyle="bold"
                android:shadowColor="#44000000"
                android:shadowDy="1"
                android:shadowRadius="4"/>

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/music_unknown_artist"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_artist_size"
                android:alpha="0.85"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 权限引导卡片（简洁版） -->
    <LinearLayout
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_music_permission_card"
        android:layout_marginStart="@dimen/music_content_padding"
        android:layout_marginEnd="@dimen/music_content_padding"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:padding="32dp"
        android:visibility="gone"
        android:gravity="center"
        android:elevation="4dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_permission_icon_circle"
            android:gravity="center"
            android:text="🔐"
            android:textSize="36sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/music_permission_required"
            android:textColor="@color/music_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/music_permission_subtitle"
            android:textColor="@color/music_text_hint"
            android:textSize="13sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btn_grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_permission_grant_btn"
            android:text="@string/keymap_perm_go_grant"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:elevation="2dp"/>
    </LinearLayout>

    <!-- 主内容区（纵向/横向可切换） -->
    <LinearLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/music_content_padding"
        android:paddingEnd="@dimen/music_content_padding">

        <!-- 黑胶唱片专辑封面区 -->
        <FrameLayout
            android:id="@+id/card_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:foreground="?attr/selectableItemBackground">

            <!-- 唱片呼吸光晕 -->
            <View
                android:id="@+id/vinyl_glow"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <!-- 黑胶碟片 -->
            <ImageView
                android:id="@+id/iv_vinyl"
                android:layout_width="@dimen/music_vinyl_size"
                android:layout_height="@dimen/music_vinyl_size"
                android:layout_gravity="center"
                android:src="@drawable/bg_vinyl_disc"
                android:elevation="1dp"
                tools:ignore="ContentDescription"/>

            <!-- 专辑封面 -->
            <ImageView
                android:id="@+id/iv_album"
                android:layout_width="@dimen/music_album_size"
                android:layout_height="@dimen/music_album_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_cover_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_album_circle"
                android:elevation="2dp"
                tools:ignore="ContentDescription"/>

            <!-- 唱臂 -->
            <ImageView
                android:id="@+id/iv_tonearm"
                android:layout_width="@dimen/music_tonearm_size"
                android:layout_height="@dimen/music_tonearm_height"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/music_tonearm_margin_top"
                android:layout_marginEnd="@dimen/music_tonearm_margin_end"
                android:src="@drawable/bg_tonearm"
                android:scaleType="fitXY"
                android:elevation="3dp"
                tools:ignore="ContentDescription"/>
        </FrameLayout>

        <!-- 歌词区（9行：前4 + 当前 + 翻译 + 后4） -->
        <LinearLayout
            android:id="@+id/lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_lyric_prev4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:alpha="0.20"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>

            <TextView
                android:id="@+id/tv_lyric_prev3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="4dp"
                android:alpha="0.35"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_prev2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="4dp"
                android:alpha="0.45"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>

            <TextView
                android:id="@+id/tv_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="6dp"
                android:alpha="0.65"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:maxWidth="420dp"
                android:gravity="center"
                android:maxLines="2"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_music_lyric_focus"
                android:lineSpacingExtra="6dp"
                android:text="@string/music_no_lyrics"
                android:textColor="@color/music_lyric_current"
                android:textSize="@dimen/music_lyric_current_size"
                android:textStyle="bold"
                android:shadowColor="#44FF2D55"
                android:shadowDy="1"
                android:shadowRadius="12"/>

            <TextView
                android:id="@+id/tv_lyric_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/music_empty_lyric_hint"
                android:textColor="@color/music_text_hint"
                android:textSize="13sp"
                android:alpha="0.72"/>

            <TextView
                android:id="@+id/tv_lyric_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:alpha="0.80"
                android:textColor="@color/music_text_hint"
                android:textSize="@dimen/music_lyric_translation_size"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="6dp"
                android:alpha="0.65"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="4dp"
                android:alpha="0.45"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>

            <TextView
                android:id="@+id/tv_lyric_next3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="4dp"
                android:alpha="0.35"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_near_size"/>

            <TextView
                android:id="@+id/tv_lyric_next4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginTop="4dp"
                android:alpha="0.20"
                android:textColor="@color/music_lyric_other"
                android:textSize="@dimen/music_lyric_far_size"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 隐藏的旧按钮（保留 ID 兼容代码） -->
    <ImageView
        android:id="@+id/btn_floating_lyrics"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/btn_lyrics_settings"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:visibility="gone"/>

    <!-- 音乐律动频谱条 -->
    <com.carassistant.ui.MusicVisualizerView
        android:id="@+id/music_visualizer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/music_visualizer_height"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"/>

    <!-- 竖屏底部播放区：时间进度同行，控制键独立悬浮 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 底部渐变遮罩 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_music_bottom_overlay"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="@dimen/music_time_text_size"
                    android:fontFamily="monospace"
                    android:alpha="0.58"/>

                <SeekBar
                    android:id="@+id/sb_progress"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_music_seekbar_track"
                    android:thumb="@drawable/bg_music_seekbar_thumb"
                    android:splitTrack="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="00:00"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="@dimen/music_time_text_size"
                    android:fontFamily="monospace"
                    android:alpha="0.58"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottom_control_bar"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_lyrics_toggle"
                        android:layout_width="@dimen/music_side_btn_size"
                        android:layout_height="@dimen/music_side_btn_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_lyrics_hongqi"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/floating_lyrics_toggle"
                        android:tint="@color/music_text_primary"
                        android:padding="8dp"
                        tools:ignore="UseAppTint"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_prev"
                        android:layout_width="@dimen/music_prev_next_btn_size"
                        android:layout_height="@dimen/music_prev_next_btn_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_prev_hongqi"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="center"
                        android:contentDescription="@string/music_prev"
                        android:tint="@color/music_text_primary"
                        android:alpha="0.90"
                        tools:ignore="UseAppTint"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15">
                    <FrameLayout
                        android:id="@+id/btn_play_container"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:elevation="5dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_music_play_ring"/>
                        <ImageView
                            android:id="@+id/btn_play"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_music_play_hongqi"
                            android:scaleType="center"
                            android:padding="16dp"
                            android:tint="#FFFFFFFF"
                            android:contentDescription="@string/music_play"
                            tools:ignore="UseAppTint"/>
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_next"
                        android:layout_width="@dimen/music_prev_next_btn_size"
                        android:layout_height="@dimen/music_prev_next_btn_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_next_hongqi"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="center"
                        android:contentDescription="@string/music_next"
                        android:tint="@color/music_text_primary"
                        android:alpha="0.90"
                        tools:ignore="UseAppTint"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_playlist"
                        android:layout_width="@dimen/music_side_btn_size"
                        android:layout_height="@dimen/music_side_btn_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_list"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:scaleType="centerInside"
                        android:alpha="0.76"
                        android:contentDescription="@string/music_playlist"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 特效占位 View（代码中动态定位） -->
    <View
        android:id="@+id/play_btn_glow"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <View
        android:id="@+id/ambient_glow_1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
    <View
        android:id="@+id/ambient_glow_2"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    <!-- 音乐来源按钮（保留 ID 兼容代码） -->
    <ImageView
        android:id="@+id/btn_music_source"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:visibility="gone"/>

</LinearLayout>
