<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_bg"
    android:paddingLeft="28dp"
    android:paddingTop="28dp"
    android:paddingRight="28dp"
    android:paddingBottom="28dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/cv_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_title"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cv_accent"
            android:id="@+id/backBtn"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cv_muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="开关门/挂档/拨转向后再点，看数字变不变"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/cv_text"
        android:id="@+id/doorDiagBtn"
        android:background="@drawable/cv_btn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="门状态诊断"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/cv_text"
        android:id="@+id/gearDiagBtn"
        android:background="@drawable/cv_btn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="档位当前值"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/cv_text"
        android:id="@+id/turnDiagBtn"
        android:background="@drawable/cv_btn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="转向灯/双闪诊断"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cv_text"
            android:id="@+id/diagResult"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="结果会显示在这里"
            android:lineSpacingExtra="5dp"
            android:textIsSelectable="true"/>
    </ScrollView>
</LinearLayout>
