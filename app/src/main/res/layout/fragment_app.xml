<?xml version="1.0" encoding="utf-8"?>
<!--
    应用管理页：渐变头部（标题+总数） + 搜索框 + Tab + 列表
    优化点：
    - 头部下方加搜索框，提升查找效率（大屏应用多）
    - Tab 样式更精致
    - 卡片间距统一
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- 顶部渐变头部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_page_header"
        android:paddingStart="@dimen/header_padding_h"
        android:paddingEnd="@dimen/header_padding_h"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingBottom="@dimen/header_padding_bottom">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_app_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_white_70"
            android:textSize="13sp"
            tools:text="共 12 个应用"/>
    </LinearLayout>

    <!-- 搜索框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        android:layout_marginTop="-8dp"
        android:elevation="3dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search_white"
            android:tint="@color/text_hint"
            tools:ignore="UseAppTint"/>

        <EditText
            android:id="@+id/et_app_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="@string/app_search_hint"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"/>

        <ImageView
            android:id="@+id/iv_app_search_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_panel_close"
            android:tint="@color/text_hint"
            android:padding="2dp"
            android:visibility="gone"
            tools:ignore="UseAppTint"/>
    </LinearLayout>

    <!-- Tab + 列表卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/page_padding"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="10dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/brand_primary"
            app:tabSelectedTextColor="@color/brand_primary"
            app:tabTextColor="@color/text_secondary"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="false"
            app:tabRippleColor="@color/brand_primary_light"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh_app"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_app"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/tv_app_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/empty_list"
                android:textColor="@color/text_hint"
                android:textSize="14sp"
                android:drawableTop="@drawable/ic_empty_box"
                android:drawablePadding="14dp"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
