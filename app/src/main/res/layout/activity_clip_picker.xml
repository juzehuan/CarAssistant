<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/cv_brand"
            android:id="@+id/pickerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择音频"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cv_accent"
            android:id="@+id/pickerBack"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/cv_text"
        android:textColorHint="@color/cv_muted"
        android:id="@+id/clipSearch"
        android:background="@drawable/cv_btn"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="搜索音频（可跨分类）"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cv_muted"
        android:id="@+id/clipSearchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="先选分类，再试听/选用"/>
    <ListView
        android:id="@+id/clipList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:listSelector="@android:color/transparent"
        android:divider="@color/cv_line"
        android:dividerHeight="1dp"
        android:layout_weight="1"/>
</LinearLayout>
