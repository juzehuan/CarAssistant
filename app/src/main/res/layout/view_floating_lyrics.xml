<?xml version="1.0" encoding="utf-8"?>
<!--
    悬浮歌词视图（增强版，与音乐伴侣主界面风格统一）
    - 深色玻璃卡片 + 左侧红色装饰条
    - 歌词带有红色微光
    - 歌曲名使用红色强调
    - 可拖动，点击跳转到音乐伴侣
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_lyrics"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:minWidth="220dp"
    android:maxWidth="420dp">

    <!-- 当前歌词行 -->
    <TextView
        android:id="@+id/tv_float_lyric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="380dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="暂无歌词"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:shadowColor="#44EE0A24"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"/>

    <!-- 歌曲信息 -->
    <TextView
        android:id="@+id/tv_float_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="380dp"
        android:text=""
        android:textColor="#FFE60026"
        android:textSize="11sp"
        android:textStyle="bold"
        android:alpha="0.90"/>
</LinearLayout>
