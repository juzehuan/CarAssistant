<?xml version="1.0" encoding="utf-8"?>
<!--
    侧边栏面板布局
    - 宽度 240dp，全高
    - 结构：头部(标题+关闭) + 系统开关区 + 快捷应用网格 + 导航快捷按钮
    - 背景运行时动态设置（左/右侧圆角）
    - 不使用 ?attr 主题属性（Service 上下文 inflate 兼容）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sidebar_root"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sidebar_panel_right">

    <!-- 头部：标题 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_float_logo"
            android:tint="@color/brand_primary"
            tools:ignore="UseAppTint,ContentDescription"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/sidebar_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/iv_sidebar_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_panel_close"
            android:padding="6dp"
            android:tint="@color/text_hint"
            tools:ignore="UseAppTint,ContentDescription"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/divider"/>

    <!-- 系统快捷开关区：WiFi/蓝牙/亮度/手电筒/旋转 -->
    <LinearLayout
        android:id="@+id/ll_sidebar_toggles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/toggle_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:id="@+id/iv_toggle_wifi"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_quick_wifi"
                android:padding="8dp"
                android:background="@drawable/bg_quick_toggle_on"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:id="@+id/tv_toggle_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_wifi"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toggle_bluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:id="@+id/iv_toggle_bluetooth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_quick_bluetooth"
                android:padding="8dp"
                android:background="@drawable/bg_quick_toggle_on"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:id="@+id/tv_toggle_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_bluetooth"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toggle_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_quick_brightness"
                android:padding="8dp"
                android:background="@drawable/bg_quick_toggle_on"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_brightness"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toggle_torch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:id="@+id/iv_toggle_torch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_quick_torch"
                android:padding="8dp"
                android:background="@drawable/bg_quick_toggle_off"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_torch"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toggle_rotation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:id="@+id/iv_toggle_rotation"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_quick_rotation"
                android:padding="8dp"
                android:background="@drawable/bg_quick_toggle_off"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_rotation"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:background="@color/divider"/>

    <!-- 快捷应用区标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="@string/sidebar_apps"
        android:textColor="@color/text_hint"
        android:textSize="11sp"/>

    <!-- 快捷应用网格 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sidebar_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"/>
        <TextView
            android:id="@+id/tv_sidebar_apps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/sidebar_apps_empty"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:drawableTop="@drawable/ic_empty_box"
            android:drawablePadding="8dp"
            android:visibility="gone"/>
        <ProgressBar
            android:id="@+id/pb_sidebar_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/divider"/>

    <!-- 导航快捷按钮：返回/主页/最近任务/锁屏 -->
    <LinearLayout
        android:id="@+id/ll_sidebar_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/nav_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_quick_back"
                android:padding="8dp"
                android:background="@drawable/bg_float_quick_button_ripple"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_back"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_quick_home"
                android:padding="8dp"
                android:background="@drawable/bg_float_quick_button_ripple"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_home"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_recents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_quick_recents"
                android:padding="8dp"
                android:background="@drawable/bg_float_quick_button_ripple"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_recents"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_lock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_quick_lock"
                android:padding="8dp"
                android:background="@drawable/bg_float_quick_button_ripple"
                tools:ignore="UseAppTint,ContentDescription"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_lock"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
