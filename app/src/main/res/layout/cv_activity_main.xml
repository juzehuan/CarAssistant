<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_bg"
    android:paddingLeft="22dp"
    android:paddingTop="22dp"
    android:paddingRight="22dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/cv_brand"
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cv_accent"
                android:id="@+id/aboutBtn"
                android:background="@drawable/cv_about_chip"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cv_about_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cv_muted"
                android:id="@+id/diagBtn"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/diag_title"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/cv_master_row"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/cv_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cv_master_label"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cv_accent"
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/status_off"/>
        </LinearLayout>
        <CheckBox
            android:id="@+id/enableCB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1.35"
            android:scaleY="1.35"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_master_row"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vol_boost_label"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/cv_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/vol_boost_hint"/>
            </LinearLayout>
            <CheckBox
                android:id="@+id/volBoostCB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.25"
                android:scaleY="1.25"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/volLevelRow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cv_muted"
                android:gravity="center"
                android:id="@+id/volMid"
                android:background="@drawable/cv_tab_off"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/vol_level_mid"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cv_text"
                android:gravity="center"
                android:id="@+id/volMidHigh"
                android:background="@drawable/cv_tab_on"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:text="@string/vol_level_mid_high"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cv_muted"
                android:gravity="center"
                android:id="@+id/volMax"
                android:background="@drawable/cv_tab_off"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:text="@string/vol_level_max"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_master_row"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_mute_label"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/cv_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/cv_mute_hint"/>
            </LinearLayout>
            <CheckBox
                android:id="@+id/muteCB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.25"
                android:scaleY="1.25"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/a11yBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/cv_accent"
            android:id="@+id/openA11yBtn"
            android:background="@drawable/cv_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="打开无障碍设置"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cv_muted"
            android:id="@+id/a11yHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hint_a11y"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cv_text"
            android:gravity="center"
            android:id="@+id/tabGear"
            android:background="@drawable/cv_tab_on"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="档位音频"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cv_muted"
            android:gravity="center"
            android:id="@+id/tabDoor"
            android:background="@drawable/cv_tab_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:text="车门音频"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cv_muted"
            android:gravity="center"
            android:id="@+id/tabMore"
            android:background="@drawable/cv_tab_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:text="转向灯"
            android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/pageGear"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cv_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="启用档位播报"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/gearCB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cv_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/gear_hint"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/gearEventHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:id="@+id/pageDoor"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <CheckBox
                    android:textColor="@color/cv_text"
                    android:id="@+id/doorFlCB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="主驾"
                    android:layout_weight="1"/>
                <CheckBox
                    android:textColor="@color/cv_text"
                    android:id="@+id/doorFrCB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="副驾"
                    android:layout_weight="1"/>
                <CheckBox
                    android:textColor="@color/cv_text"
                    android:id="@+id/doorRlCB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="左后"
                    android:layout_weight="1"/>
                <CheckBox
                    android:textColor="@color/cv_text"
                    android:id="@+id/doorRrCB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="右后"
                    android:layout_weight="1"/>
            </LinearLayout>
            <CheckBox
                android:textColor="@color/cv_text"
                android:id="@+id/doorOpenOnlyCB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仅播「打开」"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/doorEventHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:id="@+id/pageMore"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cv_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="启用转向灯/双闪播报"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/turnCB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cv_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/turn_hint"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/turnEventHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/cv_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>
            <CheckBox
                android:textColor="@color/cv_text"
                android:id="@+id/bootCB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开机提醒开启无障碍"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
