<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/qg_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/heroGlow"
        android:background="@drawable/qg_hero_glow"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:alpha="0.4"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="18dp"
            android:paddingRight="16dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/qg_accent"
                        android:background="@drawable/qg_badge_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="红旗氛围灯"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/qg_accent"
                            android:id="@+id/aboutBtn"
                            android:background="@drawable/qg_about_chip"
                            android:paddingLeft="16dp"
                            android:paddingTop="9dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="9dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/qg_about_title"/>
                        <View
                            android:id="@+id/liveDot"
                            android:background="@drawable/qg_live_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginLeft="10dp"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/qg_muted"
                            android:id="@+id/liveLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="Bingxin"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:textColor="@color/qg_text"
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/app_name"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/qg_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tagline"/>
                <View
                    android:id="@+id/brandLine"
                    android:background="@color/qg_brand"
                    android:layout_width="64dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/qg_hud_panel"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/qg_muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="当前模式"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/qg_warm"
                            android:id="@+id/modeCodeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="狂暴模式"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/qg_accent"
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"/>
                    <FrameLayout
                        android:id="@+id/speedTrack"
                        android:background="@drawable/qg_speed_track"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp">
                        <View
                            android:id="@+id/speedFill"
                            android:background="@drawable/qg_speed_fill"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/a11yBlock"
                android:background="@drawable/qg_perm_warn"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/qg_warn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/qg_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hint_body"
                    android:lineSpacingExtra="2dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/permBtnRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <Button
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/qg_text"
                        android:id="@+id/a11yBtn"
                        android:background="@drawable/qg_btn_accent"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:text="@string/a11y_btn"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="13sp"
                        android:textColor="@color/qg_text"
                        android:id="@+id/notifBtn"
                        android:background="@drawable/qg_btn_bg"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="8dp"
                        android:text="@string/notif_btn"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/masterRow"
                android:background="@drawable/qg_master_row"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="10dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/qg_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qg_master_label"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/qg_muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/master_hint"/>
                </LinearLayout>
                <CheckBox
                    android:textColor="@color/qg_text"
                    android:id="@+id/enableCB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/modeCard"
                    android:background="@drawable/qg_card_bg"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/modeFlashBar"
                        android:background="@color/qg_brand"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.55"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/qg_warm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_title"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/qg_muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/mode_hint"/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/modeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeRageRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="狂暴模式\10强拍换色 · 跟乐爆发"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeSoftRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="柔和呼吸\10慢扫邻近色 · 跟乐舒缓"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeGradientRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="慢速渐变\10色板慢游 · 跟乐漫游"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modePulseRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="单色脉动\10基准色跳动 · 跟乐脉动"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeEvRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="电车呼吸\10不跟音乐 · 慢呼吸换色"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeDriveRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="驾驶联动\10慢暖快红 · 倒车黄闪"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeCustomMusicRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="自定义跟乐\10自选色板 · 跟乐换色"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="@color/qg_text"
                            android:id="@+id/modeCustomAutoRB"
                            android:background="@drawable/qg_mode_idle"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="自定义换色\10自选色板 · 定时轮换"/>
                    </RadioGroup>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/customPanel"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/qg_warm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_palette_title"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/qg_muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/custom_palette_hint"/>
                        <HorizontalScrollView
                            android:scrollbars="none"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/customPaletteRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </HorizontalScrollView>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <View
                                android:id="@+id/customColorSwatch"
                                android:background="@color/qg_brand"
                                android:layout_width="28dp"
                                android:layout_height="28dp"/>
                            <SeekBar
                                android:id="@+id/customColorSeek"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="6dp"
                                android:max="252"
                                android:layout_weight="1"/>
                            <Button
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/qg_text"
                                android:id="@+id/customColorMinusBtn"
                                android:background="@drawable/qg_btn_bg"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="-"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/qg_accent"
                                android:gravity="center"
                                android:id="@+id/customColorLabel"
                                android:paddingLeft="4dp"
                                android:paddingRight="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="56dp"/>
                            <Button
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/qg_text"
                                android:id="@+id/customColorPlusBtn"
                                android:background="@drawable/qg_btn_bg"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginRight="6dp"
                                android:text="+"/>
                            <Button
                                android:textSize="12sp"
                                android:textColor="@color/qg_text"
                                android:id="@+id/customAddBtn"
                                android:background="@drawable/qg_btn_accent"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="56dp"
                                android:text="@string/custom_add"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/customIntervalBlock"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <TextView
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/qg_warm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/custom_interval_title"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp">
                                <TextView
                                    android:textSize="11sp"
                                    android:textColor="@color/qg_muted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2秒"/>
                                <SeekBar
                                    android:id="@+id/customIntervalSeek"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:layout_marginRight="6dp"
                                    android:max="28"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textSize="11sp"
                                    android:textColor="@color/qg_muted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="30秒"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/qg_accent"
                                android:id="@+id/customIntervalLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <Button
                                android:textSize="13sp"
                                android:textColor="@color/qg_text"
                                android:id="@+id/customPreviewBtn"
                                android:background="@drawable/qg_btn_accent"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginRight="8dp"
                                android:text="@string/custom_preview"
                                android:layout_weight="1"/>
                            <Button
                                android:textSize="13sp"
                                android:textColor="@color/qg_text"
                                android:id="@+id/customResetBtn"
                                android:background="@drawable/qg_btn_bg"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:text="@string/custom_reset"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:id="@+id/modeFxGlow"
                    android:background="@color/qg_brand"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
