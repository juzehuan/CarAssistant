<?xml version="1.0" encoding="utf-8"?>
<!--
    自启管理页（重构优化版 v3）
    设计方向：精致工程感
    - 渐变头部：返回 + 标题 + 数量徽章 + 刷新 + 添加（图标+文字，开机自启项 Tab 专属）
    - 分段式 Tab 控件（凹槽容器 + 浮起选中态）
    - 系统 Tab：搜索框 + 筛选 chip（白底/品牌浅蓝双态）
    - 用户 Tab：说明 + 全部启动按钮（品牌渐变） + 启动参数卡片（分组+单位后缀）
    - 列表 + 空态 + 加载态
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- ============ 渐变头部：返回 + 标题 + 刷新（精简，Tab 切换不变化）============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_home_header"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingBottom="@dimen/header_padding_bottom">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/back_btn_size"
            android:layout_height="@dimen/back_btn_size"
            android:src="@drawable/ic_back_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            tools:ignore="UseAppTint"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/autostart_title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_refresh_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/autostart_refresh"
            android:padding="6dp"
            tools:ignore="UseAppTint"/>
    </LinearLayout>

    <!-- ============ 分段 Tab + 数量徽章 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_top_bar"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_segment_container"
            android:padding="3dp">

            <TextView
                android:id="@+id/tab_system"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/autostart_tab_system"
                android:textColor="@color/brand_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_segment_active"/>

            <TextView
                android:id="@+id/tab_user"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/autostart_tab_user"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_filter_active"
            tools:ignore="HardcodedText"
            tools:text="共 0 个"/>
    </LinearLayout>

    <!-- ============ 系统 Tab 工具栏：搜索 + 筛选 chip ============ -->
    <LinearLayout
        android:id="@+id/system_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- 搜索框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search_gray"
                android:contentDescription="@string/autostart_search_hint"
                tools:ignore="UseAppTint"/>

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/autostart_search_hint"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                tools:ignore="Autofill,LabelFor"/>

            <ImageView
                android:id="@+id/iv_search_clear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_panel_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:visibility="gone"
                tools:ignore="UseAppTint"/>
        </LinearLayout>

        <!-- 筛选 chip 栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/autostart_filter_all"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_filter_active"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chip_system"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/autostart_filter_system"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip_filter"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chip_user"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/autostart_filter_user"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip_filter"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 用户 Tab 工具栏：说明 + 全部启动 + 启动参数卡片 ============ -->
    <LinearLayout
        android:id="@+id/user_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- 说明 + 添加 + 全部启动 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_user_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autostart_user_desc"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_btn_add_refined"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_add_white"
                    android:tint="@color/brand_primary"
                    tools:ignore="UseAppTint"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/autostart_add"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_launch_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_btn_launch_all"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_play_white"
                    tools:ignore="UseAppTint"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/autostart_launch_all"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 启动参数卡片（开机自启项 Tab 专属） -->
        <LinearLayout
            android:id="@+id/card_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_lg"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/card_elevation">

            <!-- 标题行 + 总开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_feature_autostart"
                    android:background="@drawable/bg_icon_autostart"
                    android:padding="8dp"
                    tools:ignore="UseAppTint"/>

                <TextView
                    style="@style/CardTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/autostart_options"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_autostart_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/SwitchBrand"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/autostart_options_desc"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider"/>

            <!-- 分组标题：启动时序 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/autostart_section_timing"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <!-- 首次延迟 + 间隔（两列，带单位后缀） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/autostart_first_delay"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_refined"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <EditText
                            android:id="@+id/et_first_delay"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:inputType="number"
                            android:maxLength="3"
                            android:gravity="center_vertical"
                            tools:ignore="Autofill,LabelFor"
                            tools:text="5"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/autostart_unit_seconds"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/autostart_interval"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_refined"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <EditText
                            android:id="@+id/et_interval"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:inputType="number"
                            android:maxLength="3"
                            android:gravity="center_vertical"
                            tools:ignore="Autofill,LabelFor"
                            tools:text="3"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/autostart_unit_seconds"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider"/>

            <!-- 分组标题：启动行为 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/autostart_section_behavior"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <!-- 启动后返回桌面开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/autostart_return_home"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_return_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/SwitchBrand"/>
            </LinearLayout>

            <!-- 保存按钮 -->
            <Button
                android:id="@+id/btn_save_options"
                style="@style/Widget.CarAssistant.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:text="@string/ok"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 系统自启项列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_autostart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/page_padding"
            android:clipToPadding="false"/>

        <!-- 开机自启项列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_user_autostart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/page_padding"
            android:clipToPadding="false"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/autostart_empty"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:drawableTop="@drawable/ic_empty_box"
            android:drawablePadding="14dp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
