<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_bg"
    android:paddingLeft="22dp"
    android:paddingTop="20dp"
    android:paddingRight="22dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/cv_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disclaimer_title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="false"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cv_text"
            android:id="@+id/disclaimerBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclaimer_body"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/adSlot"
        android:background="@drawable/cv_wait_card"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cv_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_ad_label"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cv_muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_ad_duration"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cv_muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/disclaimer_ad_hint"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cv_text"
            android:id="@+id/adCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="剩余 60 秒"/>
        <ProgressBar
            android:id="@+id/adProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="60"
            android:progress="0"
            android:progressDrawable="@drawable/cv_wait_progress"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cv_muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/disclaimer_input_hint"/>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/cv_text"
        android:textColorHint="@color/cv_muted"
        android:id="@+id/agreeInput"
        android:background="@drawable/cv_btn"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:hint="请输入：同意，后果自行承担"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionDone"/>
    <Button
        android:enabled="false"
        android:textSize="15sp"
        android:textColor="@color/cv_muted"
        android:id="@+id/agreeBtn"
        android:background="@drawable/cv_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="@string/disclaimer_agree_btn"/>
    <Button
        android:textSize="14sp"
        android:textColor="@color/cv_muted"
        android:id="@+id/exitBtn"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/disclaimer_exit_btn"/>
</LinearLayout>
