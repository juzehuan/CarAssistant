<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cv_master_row"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="64dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/cv_text"
        android:id="@+id/eventTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/eventActions"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cv_accent"
        android:ellipsize="end"
        android:id="@+id/eventClip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/eventActions"
        android:layout_below="@+id/eventTitle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/eventActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <Button
            android:textSize="12sp"
            android:textColor="@color/cv_text"
            android:id="@+id/eventPreview"
            android:background="@drawable/cv_btn"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="试听"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/cv_accent"
            android:id="@+id/eventPick"
            android:background="@drawable/cv_btn"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:text="更换"/>
    </LinearLayout>
</RelativeLayout>
