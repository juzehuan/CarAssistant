<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐卡片背景（移植自鸿启桌面 bg_music_card.xml）
    - 暖色调渐变：深棕 → 中棕 → 橙红
    - 圆角矩形
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FF2A1A15"
        android:centerColor="#FF3D2817"
        android:endColor="#FFFF8A50"
        android:angle="135"
        android:type="linear"/>
    <corners android:radius="24dp"/>
</shape>
