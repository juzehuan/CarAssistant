<?xml version="1.0" encoding="utf-8"?>
<!--
    黑胶唱片背景（网易云音乐经典风格）
    - 纯黑盘面 + 同心圆纹路（仅在外圈边框区域）
    - 中心区域留给专辑封面（220dp）覆盖
    - 唱片与封面交界处一圈极淡红色描边作为点缀
    - 简约不花哨
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:height="320dp"
    android:width="320dp"
    android:viewportWidth="320"
    android:viewportHeight="320">

    <!-- 外圈微高光（极淡，营造反光） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.03"
        android:pathData="M160,160 m-160,0 a160,160 0 1,0 320,0 a160,160 0 1,0 -320,0"/>

    <!-- 黑色盘面 -->
    <path
        android:fillColor="#FF0A0A0A"
        android:pathData="M160,160 m-152,0 a152,152 0 1,0 304,0 a152,152 0 1,0 -304,0"/>

    <!-- 纹路 1（最外圈） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1F1F1F"
        android:strokeWidth="1"
        android:pathData="M160,160 m-146,0 a146,146 0 1,0 292,0 a146,146 0 1,0 -292,0"/>

    <!-- 纹路 2 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1F1F1F"
        android:strokeWidth="1"
        android:pathData="M160,160 m-138,0 a138,138 0 1,0 276,0 a138,138 0 1,0 -276,0"/>

    <!-- 纹路 3 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1F1F1F"
        android:strokeWidth="1"
        android:pathData="M160,160 m-130,0 a130,130 0 1,0 260,0 a130,130 0 1,0 -260,0"/>

    <!-- 纹路 4 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1F1F1F"
        android:strokeWidth="1"
        android:pathData="M160,160 m-122,0 a122,122 0 1,0 244,0 a122,122 0 1,0 -244,0"/>

    <!-- 纹路 5 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF2A2A2A"
        android:strokeWidth="0.5"
        android:pathData="M160,160 m-115,0 a115,115 0 1,0 230,0 a115,115 0 1,0 -230,0"/>

    <!-- 中心圆盘（被专辑封面覆盖，留作底色） -->
    <path
        android:fillColor="#FF1A1A1A"
        android:pathData="M160,160 m-110,0 a110,110 0 1,0 220,0 a110,110 0 1,0 -220,0"/>

    <!-- 唱片与封面交界处极淡红色描边（网易云点缀） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFE60026"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.5"
        android:pathData="M160,160 m-110,0 a110,110 0 1,0 220,0 a110,110 0 1,0 -220,0"/>

    <!-- 中心孔（黑色，被封面遮挡，仅作结构保留） -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M160,160 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"/>

</vector>
