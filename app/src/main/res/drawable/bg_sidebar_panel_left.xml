<?xml version="1.0" encoding="utf-8"?>
<!--
    侧边栏面板背景：从左侧滑出
    - 直角无圆角（按需求去除圆角）
    - gradient angle=315（45 的倍数，兼容 Android 9）
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#F2F5FA"
        android:endColor="#FFFFFFFF"
        android:angle="315"
        android:type="linear"/>
    <corners android:radius="0dp"/>
    <stroke
        android:width="1dp"
        android:color="@color/stroke_card"/>
</shape>
