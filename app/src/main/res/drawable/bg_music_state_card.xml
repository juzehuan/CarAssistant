<?xml version="1.0" encoding="utf-8"?>
<!-- 首页音乐当前播放卡片背景（暗色玻璃 + 左侧红色装饰条） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6151A28"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:right="20dp" android:gravity="left">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFEE0A24"
                android:endColor="#FFB00D1F"
                android:angle="270"
                android:type="linear"/>
            <corners
                android:topLeftRadius="16dp"
                android:bottomLeftRadius="16dp"/>
            <size android:width="4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="0.5dp" android:color="#20EE0A24"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
