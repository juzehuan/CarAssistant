<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐伴侣背景光斑（飘动效果）
    - 两个柔和的金色/红色光斑
    - 通过 translate 动画缓慢飘动
    - 营造音乐氛围
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:startColor="#40C9A961"
        android:endColor="#00C9A961"
        android:gradientRadius="120dp"
        android:type="radial"/>
</shape>
