<?xml version="1.0" encoding="utf-8"?>
<!--
    黑胶唱片唱臂（导轨）— 网易云音乐风格
    特征：
    - 极细长金属唱臂管（从右上枢轴斜向左下延伸到唱片中心）
    - 简约圆形枢轴底座（小尺寸，不喧宾夺主）
    - 小巧配重块（在枢轴右侧）
    - 精致唱头 + 极细唱针
    - 深灰色金属质感，与网易云黑胶模式一致
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="250">

    <!-- ============ 配重块（枢轴右侧的小圆柱） ============ -->
    <!-- 配重块主体 -->
    <path
        android:fillColor="#FF383838"
        android:pathData="M178,32 L198,32 L198,60 L178,60 Z"/>
    <!-- 配重块高光（顶部） -->
    <path
        android:fillColor="#FF5A5A5A"
        android:pathData="M178,32 L198,32 L198,36 L178,36 Z"/>
    <!-- 配重块阴影（底部） -->
    <path
        android:fillColor="#FF222222"
        android:pathData="M178,56 L198,56 L198,60 L178,60 Z"/>
    <!-- 配重块刻纹（2 道细纹） -->
    <path
        android:strokeColor="#FF1A1A1A"
        android:strokeWidth="0.5"
        android:pathData="M178,42 L198,42 M178,50 L198,50"/>

    <!-- ============ 枢轴底座（简约圆形） ============ -->
    <!-- 外圈（深色底盘） -->
    <path
        android:fillColor="#FF2A2A2A"
        android:pathData="M170,46 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0"/>
    <!-- 中圈（金属渐变） -->
    <path
        android:fillColor="#FF484848"
        android:pathData="M170,46 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"/>
    <!-- 内圈（深色） -->
    <path
        android:fillColor="#FF1F1F1F"
        android:pathData="M170,46 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"/>
    <!-- 中心高光点 -->
    <path
        android:fillColor="#FF666666"
        android:pathData="M170,46 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>

    <!-- ============ 唱臂管（极细长，从枢轴到唱头） ============ -->
    <!-- 唱臂投影（柔和阴影） -->
    <path
        android:fillColor="#30000000"
        android:pathData="M166,52 C130,90 80,140 36,204 L32,210 L28,206 L34,200 C78,136 128,86 162,48 Z"/>
    <!-- 唱臂管主体（深灰色） -->
    <path
        android:fillColor="#FF3A3A3A"
        android:pathData="M164,50 C128,88 78,138 34,202 L30,208 L26,204 L32,198 C76,132 126,82 160,46 Z"/>
    <!-- 唱臂管高光（顶部金属反光，极细线） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M163,49 C127,87 77,137 33,201 L31,203 C75,137 125,87 159,47 Z"/>
    <!-- 唱臂管中心亮线（镜面反射） -->
    <path
        android:fillColor="#FF9A9A9A"
        android:pathData="M163.5,49.5 C127.5,87.5 77.5,137.5 33.5,201.5 L32,202.5 C76,136.5 126,86.5 160,46.5 Z"/>

    <!-- ============ 唱头连接环（枢轴下方连接件） ============ -->
    <path
        android:fillColor="#FF1F1F1F"
        android:pathData="M162,44 L170,44 L170,52 L162,52 Z"/>
    <path
        android:fillColor="#FF424242"
        android:pathData="M164,46 L168,46 L168,50 L164,50 Z"/>

    <!-- ============ 唱头（headshell，小巧梯形） ============ -->
    <!-- 唱头主体 -->
    <path
        android:fillColor="#FF2A2A2A"
        android:pathData="M26,204 L42,196 L48,208 L34,218 C30,220 26,216 28,212 Z"/>
    <!-- 唱头渐变面 -->
    <path
        android:fillColor="#FF424242"
        android:pathData="M28,206 L40,198 L46,208 L34,216 C31,217 28,215 29,212 Z"/>
    <!-- 唱头顶部高光 -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M30,206 L40,199 L42,201 L32,208 Z"/>
    <!-- 唱头底部阴影 -->
    <path
        android:fillColor="#FF1A1A1A"
        android:pathData="M34,216 L46,208 L48,210 L34,218 Z"/>

    <!-- ============ 唱针（极细针尖） ============ -->
    <path
        android:fillColor="#FFAAAAAA"
        android:pathData="M36,216 L38,216 L37,224 Z"/>
    <!-- 唱针尖（反光点） -->
    <path
        android:fillColor="#FFDDDDDD"
        android:pathData="M36.5,222 L37.5,222 L37,224 Z"/>

</vector>
