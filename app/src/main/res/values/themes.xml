<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 亮色主题（用户偏好） -->
    <style name="Theme.CarAssistant" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Button 默认样式 -->
        <item name="materialButtonStyle">@style/Widget.CarAssistant.Button</item>

        <!-- 自定义 AlertDialog 主题：所有 AlertDialog.Builder 自动应用 -->
        <item name="android:alertDialogTheme">@style/ThemeOverlay.CarAssistant.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.CarAssistant.Dialog</item>
    </style>

    <!-- 文本样式 -->
    <style name="CardTitleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionTitleText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodyText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CaptionText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="FeatureText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TopBar">
        <item name="android:background">@color/bg_top_bar</item>
        <item name="android:elevation" tools:targetApi="21">6dp</item>
    </style>

    <!-- Button 样式 -->
    <style name="Widget.CarAssistant.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- 主按钮（深色实底） -->
    <style name="Widget.CarAssistant.Button.Primary">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- 次按钮（浅色底+主色字） -->
    <style name="Widget.CarAssistant.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="backgroundTint">@color/brand_primary_light</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 危险按钮 -->
    <style name="Widget.CarAssistant.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/danger</item>
        <item name="backgroundTint">@color/danger_light</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 小尺寸危险按钮（用于列表项） -->
    <style name="Widget.CarAssistant.Button.Danger.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 小尺寸主按钮（用于列表项） -->
    <style name="Widget.CarAssistant.Button.Primary.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 小尺寸次按钮（用于列表项） -->
    <style name="Widget.CarAssistant.Button.Secondary.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 成功按钮（解冻用） -->
    <style name="Widget.CarAssistant.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/success</item>
        <item name="backgroundTint">@color/success_light</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 小尺寸成功按钮 -->
    <style name="Widget.CarAssistant.Button.Success.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 卡片样式 -->
    <style name="CardStyle">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- ========== 弹窗主题 ========== -->
    <!--
        通过 ThemeOverlay 自动应用到所有 AlertDialog：
        - 圆角背景 bg_dialog
        - 标题加大加粗，主色
        - 消息文字次级
        - 按钮统一品牌色，加大点击区
    -->
    <style name="ThemeOverlay.CarAssistant.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CarAssistant.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CarAssistant.DialogButton.Negative</item>
    </style>

    <!-- 弹窗按钮条：居右，留足上间距（通过 ThemeOverlay 的 buttonBarButtonStyle 间接应用） -->

    <!-- 弹窗主按钮：填充式品牌色 -->
    <style name="Widget.CarAssistant.DialogButton.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- 弹窗次按钮：描边式 -->
    <style name="Widget.CarAssistant.DialogButton.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@color/stroke_card</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
